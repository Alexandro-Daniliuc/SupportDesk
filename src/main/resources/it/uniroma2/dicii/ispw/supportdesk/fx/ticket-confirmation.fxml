<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="it.uniroma2.dicii.ispw.supportdesk.boundary.javafx.TicketConfirmationControllerGrafico"
            style="-fx-background-color: #ECEFF1;">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #1A237E; -fx-padding: 14 20;">
            <Label text="SupportDesk"
                   style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Label text="/ Conferma Ticket"
                   style="-fx-text-fill: #90CAF9; -fx-font-size: 14px;"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER">
            <padding><Insets top="32" bottom="32" left="32" right="32"/></padding>

            <VBox alignment="CENTER" spacing="20" maxWidth="480"
                  style="-fx-background-color: white;
                         -fx-background-radius: 8;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 8, 0, 0, 2);">
                <padding><Insets top="40" bottom="40" left="32" right="32"/></padding>

                <Label text="✓" style="-fx-font-size: 48px; -fx-text-fill: #2E7D32;"/>

                <Label text="Ticket aperto con successo!"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1A237E;"/>

                <Label fx:id="ticketIdLabel" text=""
                       style="-fx-font-size: 14px; -fx-text-fill: #424242;"/>

                <Separator/>

                <Button text="← Apri Nuovo Ticket"
                        onAction="#onBack"
                        maxWidth="Infinity"
                        style="-fx-background-color: #1565C0;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10;
                               -fx-background-radius: 4;
                               -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </center>

</BorderPane>
